{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH Studio",
  "version": "0.2.0",
  "identifier": "dev.sshstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSH Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "SSH terminals and SFTP file manager",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Workspace cho terminal SSH, file SFTP, port forwarding và SSH key của nhiều server.",
    "copyright": "© SSH Studio contributors. MIT License.",
    "license": "MIT"
  }
}
